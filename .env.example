# Endereco interno do servidor. No Docker, mantenha 0.0.0.0:20000.
APP_BIND=0.0.0.0:20000

# Pasta da biblioteca vista pelo processo/container.
LIBRARY_ROOT=/pdf
DATABASE_PATH=./data/library.db
COVERS_DIR=./data/covers

# Opcional. Nunca e gravada no SQLite.
GOOGLE_BOOKS_API_KEY=
RUST_LOG=estante_livre=info,tower_http=info

